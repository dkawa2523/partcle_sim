# Python environments and bytecode
**/.venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/

# Tool caches and local coverage
**/.pytest_cache/
**/.ruff_cache/
**/.pyrefly_cache/
**/.mypy_cache/
**/.grimp_cache/
**/.import_linter_cache/
**/.hypothesis/
**/.nox/
**/.uv-cache/
**/.uv-test-cache/
**/.uv-tools/
**/.uv-bin/
**/.quality-cache/
**/.coverage
**/htmlcov/

# Build and runtime scratch
**/build/
**/dist/
**/node_modules/
**/*.log
**/*.status
tmp*/
_tmp_*/
_out_*/

# Large producer-native files are external inputs, not source files
**/*.mph
**/*.mph.lock
**/*.mphtxt
**/*.mphbin
**/*.class
hs_err_pid*.log

# Local external V&V dataset; provenance belongs in committed evidence instead
/model_dataset/

# Local experiments, execution environments and large verification payloads
/.artifacts/
/particle_platform_redesign/solver/evidence/**/*.zip
/particle_platform_redesign/solver/evidence/**/*.whl
/particle_platform_redesign/solver/evidence/**/*.h5
/particle_platform_redesign/solver/evidence/**/*.hdf5
/particle_platform_redesign/solver/evidence/**/*.npy
/particle_platform_redesign/solver/evidence/**/*.npz
/particle_platform_redesign/solver/evidence/**/*.prof
/particle_platform_redesign/solver/evidence/**/LATEST
/particle_platform_redesign/solver/evidence/**/_SUCCESS
/particle_platform_redesign/solver/evidence/**/checkpoints/
/particle_platform_redesign/solver/evidence/**/segments/
/particle_platform_redesign/solver/evidence/**/cache*/
/particle_platform_redesign/solver/evidence/**/runtime/
