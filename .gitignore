# Python environments and bytecode
**/.venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/

# Tool caches and local coverage
**/.pytest_cache/
**/.ruff_cache/
**/.pyrefly_cache/
**/.mypy_cache/
**/.grimp_cache/
**/.import_linter_cache/
**/.hypothesis/
**/.nox/
**/.uv-cache/
**/.uv-test-cache/
**/.uv-tools/
**/.uv-bin/
**/.quality-cache/
**/.coverage
**/htmlcov/

# Build and runtime scratch
**/build/
**/dist/
**/node_modules/
**/*.log
**/*.status
tmp*/
_tmp_*/
_out_*/

# Large producer-native files are external inputs, not source files
**/*.mph
**/*.mph.lock
**/*.mphtxt
**/*.mphbin
**/*.class
hs_err_pid*.log

# Local external V&V dataset; provenance belongs in committed evidence instead
/model_dataset/
